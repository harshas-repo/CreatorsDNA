# ============================================================
# CreatorsDNA — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored and
# must NEVER be committed (decision D4 / doc 04 §8.1).
#
# Every value below has a safe default, so the app runs end-to-end
# with an EMPTY environment using synthetic development data.
# ============================================================

# ---------- Cultural intelligence provider ----------
# Which provider backs the `CulturalIntelligenceProvider` boundary.
#   synthetic = clearly-labelled development data (default, no key needed)
#   qloo      = live Qloo Insights API (requires QLOO_API_KEY)
#
# The UI renders a persistent "synthetic data" banner whenever this is
# NOT `qloo`, so synthetic results can never be mistaken for Qloo
# discoveries. Do not remove that behaviour.
CREATORSDNA_PROVIDER=synthetic

# ---------- Qloo API ----------
# Obtained from the Qloo LLM Hackathon developer guide. Treat as a secret:
# server-side only, never exposed to the browser, never committed.
QLOO_API_KEY=

# Base URL. ⚠️ Doc 03 §1 calls this "the single most important fact":
# hackathon keys work ONLY against hackathon.api.qloo.com. They do NOT work
# against api.qloo.com or staging.api.qloo.com, and using the wrong host is the
# most common cause of 401 errors. Nearly every curl example in Qloo's own docs
# uses the wrong host for this environment.
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# Auth header name. Qloo requires `X-Api-Key`, NOT `Authorization: Bearer`
# (which returns 401 "No API key found in request"). Exposed only in case a
# hackathon proxy renames it.
QLOO_API_KEY_HEADER=X-Api-Key

# Request timeout in milliseconds. Qloo Insights can be slow on large
# signal arrays; 30s is the documented-ish ceiling we plan around.
QLOO_TIMEOUT_MS=30000

# Maximum concurrent in-flight Qloo requests. Set to 1 until the real
# quota is known (open item R7 / assumption A15) — this prevents an
# accidental burst from exhausting a limited hackathon key.
QLOO_MAX_CONCURRENCY=1

# Set to "true" ONLY while running the doc 04 §6 probe. When true, raw
# responses are written to the git-ignored `probe-output/` directory.
# It must never be enabled in a deployed environment.
QLOO_CAPTURE_PROBE_OUTPUT=false

# ---------- Cache (R17) ----------
# Provider-independent cache interface; the driver is swappable.
#   memory     = in-process Map, lost on restart (default; fine for dev)
#   filesystem = local disk under CACHE_DIR (development only — ephemeral
#                on serverless hosts, see doc 04 §1 D6)
#   kv         = durable production adapter (NOT YET IMPLEMENTED; the
#                interface is ready, the backend choice is still open)
CACHE_DRIVER=memory

# Directory for the filesystem driver. Git-ignored.
CACHE_DIR=.cache

# Qloo permits indefinite caching (fact F23), so production TTL can be
# long. Development uses a short TTL so changes are visible.
CACHE_TTL_SECONDS=3600

# ---------- Brand registry ----------
# Doc 04 §5: a small curated registry of real brands, enriched from Qloo
# where supported. Partnership links must come from verified official
# sources and are checked into the repo as data, never scraped at runtime.
BRAND_REGISTRY_PATH=src/data/brands.json

# ---------- GitHub push (one-time, optional, NOT used at runtime) ----------
# Personal access token used only to push this repo to GitHub over HTTPS.
# Leave this template value EMPTY. Copy it into your git-ignored `.env` and
# paste the real token there — a real token must NEVER be committed here.
GITHUB_TOKEN=

# ============================================================
# CreatorsDNA — .gitignore
#
# Established BEFORE the first commit. Doc 04 §8 makes this a hard
# constraint: the repo has never been committed, so nothing here can
# be purged from history later.
# ============================================================

# ---------- Secrets (D4 / 04 §8.1) ----------
# The Qloo API key, OpenStreetMap config, anything else sensitive.
# NEVER commit .env in any form except the committed .env.example.
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Qloo response data (D4 / 04 §8.2) ----------
# No captured Qloo response may ever be committed, including
# "public" results. Responses are identifiable and reveal the query.
probe-output/
.qloo-cache/
.cache/
captures/
fixtures/recorded/
*.qloo.json

# ---------- Runtime caches (R17 / 04 §1 D6) ----------
# Local development cache only. Production uses a durable KV/DB
# adapter; that data never lives in the repo either.
cache-data/
tmp/
.tmp/

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.js
jspm_packages/

# ---------- Next.js ----------
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# ---------- Test / coverage ----------
coverage/
.nyc_output/
*.lcov

# ---------- Verification screenshots ----------
# Browser-check artifacts from development (hero field renders, hydration
# diffs). They are never part of the product; ignored so a stray capture
# cannot be committed. Safe to delete from disk at any time.
hero-*.png
verify-*.png
qa-*.png

# ---------- Tooling / editor / OS ----------
.vercel
.turbo
.idea/
# Qoder IDE workspace: auto-generated repowiki/knowledge and local cache.
# Regenerable and machine-specific — never part of the app source.
.qoder/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
